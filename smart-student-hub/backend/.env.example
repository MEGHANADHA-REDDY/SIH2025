# Server
PORT=5000
# Set to production when deployed (enables DB SSL, strict CORS, HSTS, hides error details)
NODE_ENV=development

# Database: either DATABASE_URL (managed Postgres) or the DB_* variables below
# DATABASE_URL=postgresql://user:password@host:5432/smart_student_hub
DB_HOST=localhost
DB_PORT=5432
DB_NAME=smart_student_hub
DB_USER=postgres
DB_PASSWORD=your_password
# Optional: force SSL on/off. Defaults to on when NODE_ENV=production.
# DB_SSL=true
# DB_POOL_MAX=20

# Auth. In production JWT_SECRET must be 32+ random characters:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Public URL of the Next.js app. Used for share links and as the default CORS origin.
FRONTEND_URL=http://localhost:3000
# Optional: extra allowed browser origins, comma-separated (e.g. Vercel preview URLs)
# CORS_ORIGINS=https://app.example.com,https://www.example.com

# File uploads (bytes)
MAX_FILE_SIZE=10485760

# SMTP for scheduled report emails (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
